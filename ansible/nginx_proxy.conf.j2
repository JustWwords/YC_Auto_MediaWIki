user www-data;

events {}

http {
    upstream WikiServer {
        least_conn;
    {% for host in groups['wiki'] %}
        server {{ hostvars[host]['ansible_host'] }}:80;
    {% endfor %}
    }

    server {
        listen 80;

        location / {
            proxy_pass http://WikiServer;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        }

        location = / {
            return 301 http://$host/mediawiki/mediawiki-1.46.0/;
        }
    }

    include /etc/nginx/mime.types; 
    include /etc/zabbix/nginx.conf;
}